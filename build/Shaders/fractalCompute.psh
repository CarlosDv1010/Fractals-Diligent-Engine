cbuffer Constants : register(b0)
{
    float4 TimeAndResolution; // x=time, y=res.x, z=res.y, w=fractType
    float4 CameraPos; // xyz=pos, w=is3D
    float4 CameraDirX; // xyz=right
    float4 CameraDirY; // xyz=up
    float4 CameraDirZ; // xyz=forward

    float4 ZoomOffset; // x=zoom/size, y=off.x, z=off.y, w=off.z
    float4 FractalColor; // rgba tint
    float4 BackgroundColor; // rgba background

    float4 FractalC; // x=c.x, y=c.y
    int maxiter; // Usado para Menger iterations
    float3 FractalParams1; // x=bailout(unused), y=power_mandelbulb_min, z=unused
    float4 FractalParams2; // x=gamma(unused), y/z/w extras

    float4 Options3D; // x=maxSteps, y=maxDist, z=threshold, w=unused
    float4 AnimationParams; // x=timeScale, y=unused, z=unused, w=unused

    float4 LightPositionAndRadius; // xyz=pos, w=radius (USADO SOLO POR MANDELBULB NUEVO)
    float4 LightColorAndIntensity; // rgb=color, a=intensity (USADO SOLO POR MANDELBULB NUEVO)

    // Nuevos parámetros para ajuste fino (USADO SOLO POR MANDELBULB NUEVO)
    float aoStrengthMultiplier;
    float directLightBrightness;
    float ambientLightBrightness;
    float reflectivityFactor;
    float fresnelStrength;
    float normalEpsilonScale;
    float2 textureScale;
};

// --- FUNCIONES PARA MANDELBULB (NUEVA VERSIÓN CON PATH TRACING) ---
float DE_Mandelbulb_PathTraced(float3 pos, float power) // Renombrada para evitar conflicto si se necesitara la original
{
    float3 z = pos;
    float dr = 1.0;
    float r = 0.0;
    const float bailout = 2.0;
    const float bailout2 = bailout * bailout;
    const int iterDE = 60;

    for (int i = 0; i < iterDE; ++i)
    {
        float r2 = dot(z, z);
        r = sqrt(r2);
        if (r2 > bailout2)
            break;
        float theta = acos(clamp(z.z / r, -1.0, 1.0));
        float phi = atan2(z.y, z.x);
        dr = pow(r, power - 1.0) * power * dr + 1.0;
        float zr = pow(r, power);
        float ntheta = theta * power;
        float nphi = phi * power;
        float sinT = sin(ntheta);
        z = zr * float3(sinT * cos(nphi), sinT * sin(nphi), cos(ntheta)) + pos;
    }
    return 0.5 * log(r) * r / dr;
}

float3 calculateNormalMandelbulb_PathTraced(float3 p, float power, float epsilon)
{
    float3 n = float3(
        DE_Mandelbulb_PathTraced(p + float3(epsilon, 0, 0), power) - DE_Mandelbulb_PathTraced(p - float3(epsilon, 0, 0), power),
        DE_Mandelbulb_PathTraced(p + float3(0, epsilon, 0), power) - DE_Mandelbulb_PathTraced(p - float3(0, epsilon, 0), power),
        DE_Mandelbulb_PathTraced(p + float3(0, 0, epsilon), power) - DE_Mandelbulb_PathTraced(p - float3(0, 0, epsilon), power)
    );
    return normalize(n);
}

float SDF_Sphere_PathTraced(float3 p, float3 center, float radius)
{
    return length(p - center) - radius;
}

struct RayHitResult_PathTraced
{
    bool isHit;
    float3 hitPos;
    float3 normal;
    float distance;
    int objectType;
    float3 baseColorIfFractal;
};

RayHitResult_PathTraced castRay_PathTraced(float3 ro, float3 rd,
                                           float mandelbulbPower,
                                           float3 lightPos, float lightRadius,
                                           int maxSteps, float maxDist, float thresh, float normal_epsilon_world)
{
    RayHitResult_PathTraced result;
    result.isHit = false;
    result.distance = maxDist;
    result.objectType = 0;
    result.baseColorIfFractal = FractalColor.xyz;
    float totalDist = 0.0;

    for (int i = 0; i < maxSteps; ++i)
    {
        float3 p_world = ro + rd * totalDist;
        float distToFractal_world = DE_Mandelbulb_PathTraced(p_world, mandelbulbPower);
        float distToLight_world = SDF_Sphere_PathTraced(p_world, lightPos, lightRadius);
        float distToScene_world = min(distToFractal_world, distToLight_world);
        totalDist += distToScene_world;

        if (distToScene_world < thresh)
        {
            result.isHit = true;
            result.hitPos = p_world - rd * (distToScene_world - thresh * 0.5);
            result.distance = totalDist - (distToScene_world - thresh * 0.5);
            if (distToLight_world < distToFractal_world)
            {
                result.objectType = 2;
                result.normal = normalize(result.hitPos - lightPos);
            }
            else
            {
                result.objectType = 1;
                result.normal = calculateNormalMandelbulb_PathTraced(result.hitPos, mandelbulbPower, normal_epsilon_world);
            }
            break;
        }
        if (totalDist > maxDist)
            break;
    }
    return result;
}

float rand_PathTraced(float2 co)
{
    return frac(sin(dot(co.xy, float2(12.9898, 78.233))) * 43758.5453);
}

float calculateAO_PathTraced(float3 pos_world, float3 normal_world, float mandelbulbPower, float thresh, float normal_epsilon_world)
{
    float occlusion = 0.0;
    const int aoSamples = 5;
    const float aoRadius = 0.5 * directLightBrightness;
    const float aoMaxDistStep = aoRadius / 2.5;
    for (int i = 0; i < aoSamples; ++i)
    {
        float3 randomVec = float3(rand_PathTraced(pos_world.xy + float(i)) - 0.5, rand_PathTraced(pos_world.yz + float(i)) - 0.5, rand_PathTraced(pos_world.zx + float(i)) - 0.5);
        float3 sampleDir = normalize(normal_world + randomVec * 0.7);
        if (dot(sampleDir, normal_world) < 0.05)
            sampleDir = reflect(sampleDir, normal_world);
        if (dot(sampleDir, normal_world) < 0.05)
            sampleDir = normal_world;
        float totalSampleDist = thresh * 1.1;
        for (int j = 0; j < 5; ++j)
        {
            float3 pSample_world = pos_world + sampleDir * totalSampleDist;
            float dFractal_world = DE_Mandelbulb_PathTraced(pSample_world, mandelbulbPower);
            if (dFractal_world < thresh)
            {
                occlusion += (1.0 - smoothstep(0.0, aoRadius, totalSampleDist));
                break;
            }
            totalSampleDist += min(dFractal_world, aoMaxDistStep);
            if (totalSampleDist > aoRadius)
                break;
        }
    }
    return saturate(1.0 - (occlusion / float(aoSamples)) * aoStrengthMultiplier);
}

float3 GetBackgroundColorFromRay_PathTraced(float3 rayDir)
{
    float gradientFactor = saturate(rayDir.y * 0.5 + 0.5);
    float3 horizonColor = float3(0.6, 0.7, 0.85);
    return lerp(horizonColor, BackgroundColor.xyz, gradientFactor);
}

float3 getPointDirectIllumination_PathTraced(float3 hitPos_world, float3 normal_world, float3 viewDir, float3 baseColor,
                                             float3 lightPos_world, float3 lightEmissiveColorWithIntensity)
{
    float3 actualLightDir = normalize(lightPos_world - hitPos_world);
    float diffuse = saturate(dot(normal_world, actualLightDir));
    float distToLight = length(lightPos_world - hitPos_world);
    float attenuation = 1.0 / (1.0 + 0.08 * distToLight + 0.03 * distToLight * distToLight);
    float3 halfwayDir = normalize(actualLightDir + viewDir);
    float specAngle = saturate(dot(normal_world, halfwayDir));
    float specular = pow(specAngle, 24.0);
    return baseColor * diffuse * lightEmissiveColorWithIntensity * attenuation * directLightBrightness +
           specular * lightEmissiveColorWithIntensity * attenuation * directLightBrightness * 0.7;
}


// --- FUNCIONES PARA MENGER SPONGE (VERSIÓN ORIGINAL RESTAURADA) ---
float DE_MengerSponge_Original(float3 pos, int iterations)
{
    float d = length(max(abs(pos) - 1.0, 0.0));
    float s = 1.0;
    for (int i = 0; i < iterations; ++i)
    {
        s /= 3.0;
        float3 a = fmod(abs(pos), 2.0 * s) - s;
        float da = max(abs(a.x), abs(a.y));
        float db = max(abs(a.y), abs(a.z));
        float dc = max(abs(a.z), abs(a.x));
        d = max(d, -min(da, min(db, dc)));
    }
    return d;
}

float getCross_Original(float3 p, float size_for_cross) // Renombrado size a size_for_cross
{
    p = abs(p) - size_for_cross / 3.0;
    float bx = max(p.y, p.z);
    float by = max(p.x, p.z);
    float bz = max(p.x, p.y);
    return min(min(bx, by), bz);
}

float getInnerMenger_Original(float3 p, float menger_size, int iterations, float initial_dist_thresh)
{
    float d = initial_dist_thresh; // Usar el threshold pasado
    float scale = 1.0;
    for (int i = 0; i < iterations; i++)
    {
        float r = menger_size / scale;
        float3 q = fmod(p + r, 2.0 * r) - r;
        d = min(d, getCross_Original(q, r));
        scale *= 3.0;
    }
    return d;
}

float4 map_Menger_Original(float3 p, float menger_size, int iterations, float initial_dist_thresh)
{
    float d = -getInnerMenger_Original(p, menger_size, iterations, initial_dist_thresh);
    // El color original era simple, podemos usar FractalColor.xyz o mantenerlo si es necesario
    float3 col = FractalColor.xyz; // abs(floor(p * 3.0 / menger_size - 0.5) + 0.1); 
    return float4(col, d);
}

float4 rayMarch_Menger_Original(float3 ro, float3 rd, float menger_size, int iterations, float thresh, float maxDist, int maxSteps, float initial_dist_thresh_for_map)
{
    float current_dist_marched = 0; // Renombrado para evitar confusión con la 'd' de la SDF
    float3 p_on_ray;
    float3 hit_color = FractalColor.xyz; // Color por defecto
    
    for (int i = 0; i < maxSteps; i++)
    {
        p_on_ray = ro + rd * current_dist_marched;
        float4 map_result = map_Menger_Original(p_on_ray, menger_size, iterations, initial_dist_thresh_for_map);
        hit_color = map_result.rgb; // Actualizar color en cada paso (como en el original)
        
        float estimated_dist_to_surface = map_result.w; // Esta es la distancia con signo de map_Menger_Original

        if (estimated_dist_to_surface < thresh) // Si la distancia estimada es menor que el umbral, consideramos un hit
            break;
        
        current_dist_marched += estimated_dist_to_surface; // Avanzar por la distancia estimada
        
        if (current_dist_marched > maxDist)
            break;
    }
    return float4(hit_color, current_dist_marched); // Devolver el color del último punto y la distancia total marchada
}

float3 getNormal_Menger_Original(float3 p, float menger_size, int iterations, float thresh, float initial_dist_thresh_for_map)
{
    float2 e = float2(thresh * 0.5, 0.0); // Usar un epsilon más pequeño para normales
    float d_center = map_Menger_Original(p, menger_size, iterations, initial_dist_thresh_for_map).w;
    float3 n = d_center - float3(
        map_Menger_Original(p - e.xyy, menger_size, iterations, initial_dist_thresh_for_map).w,
        map_Menger_Original(p - e.yxy, menger_size, iterations, initial_dist_thresh_for_map).w,
        map_Menger_Original(p - e.yyx, menger_size, iterations, initial_dist_thresh_for_map).w
    );
    return normalize(n);
}

float calculateShadow_Menger_Original(float3 p_hit, float3 lightDir_normalized, float menger_size, int iterations, float thresh, float maxDist_shadow, int maxSteps_shadow)
{
    float t = thresh * 2.0; // Empezar un poco alejado de la superficie
    float shadow_factor = 1.0;
    for (int i = 0; i < maxSteps_shadow; i++)
    {
        float3 pos_on_shadow_ray = p_hit + lightDir_normalized * t;
        // Para la sombra, usamos la SDF DE_MengerSponge_Original que devuelve distancia al sólido
        float dist_to_solid = DE_MengerSponge_Original(pos_on_shadow_ray / menger_size, iterations) * menger_size;
        
        if (dist_to_solid < thresh)
        {
            shadow_factor = 0.0; // Obstruido
            break;
        }
        // Penumbra suave (opcional, pero estaba en tu original)
        shadow_factor = min(shadow_factor, 10.0 * dist_to_solid / t);
        
        t += dist_to_solid;
        if (t > maxDist_shadow)
            break;
    }
    return shadow_factor;
}

float4 RenderMengerSponge3D_OriginalLogic(float2 uv_coords,
                                          float3 camPos, float3 camDirX, float3 camDirY, float3 camDirZ,
                                          float menger_size_param, int iterations_param,
                                          float hit_thresh_param, float max_dist_param, int max_steps_param,
                                          float3 global_fractal_color, float3 global_bg_color)
{
    float3 ro = camPos;
    float3 rd = normalize(uv_coords.x * camDirX + uv_coords.y * camDirY + camDirZ);

    // El initial_dist_thresh_for_map en map_Menger_Original se usaba para inicializar 'd' en getInnerMenger.
    // Options3D.z (hit_thresh_param) es un buen candidato para esto.
    float4 raymarch_result = rayMarch_Menger_Original(ro, rd, menger_size_param, iterations_param, hit_thresh_param, max_dist_param, max_steps_param, hit_thresh_param);
    
    float3 bg_final_color = lerp(float3(0.9, 0.8, 0.7), global_bg_color, saturate(rd.y * 0.5 + 0.5));

    if (raymarch_result.w >= max_dist_param) // Si la distancia marchada excede max_dist_param
        return float4(bg_final_color, 1.0);

    float3 p_hit_surface = ro + rd * raymarch_result.w;
    float3 normal_surface = getNormal_Menger_Original(p_hit_surface, menger_size_param, iterations_param, hit_thresh_param, hit_thresh_param);
    float3 view_dir_to_surface = normalize(ro - p_hit_surface);

    float3 light_direction = normalize(float3(0.5, 0.8, -0.3)); // Luz direccional fija como en el original
    float diffuse_lighting = saturate(dot(normal_surface, light_direction));
    float ambient_lighting = 0.2;

    float3 halfway_vector = normalize(light_direction + view_dir_to_surface);
    float spec_angle = saturate(dot(normal_surface, halfway_vector));
    float specular_lighting = pow(spec_angle, 16.0); // Menger usaba 16 en tu código anterior

    float fresnel_power_val = 5.0;
    float fresnel_effect = pow(1.0 - saturate(dot(normal_surface, view_dir_to_surface)), fresnel_power_val);

    float shadow_val = calculateShadow_Menger_Original(p_hit_surface, light_direction, menger_size_param, iterations_param, hit_thresh_param, max_dist_param / 2.0, max_steps_param / 2);

    float3 base_color_fractal = global_fractal_color; // Usar el color global
    float3 specular_highlight_color = float3(1.0, 1.0, 1.0);
    float3 fresnel_rim_color = float3(1.0, 0.9, 0.8);

    float3 lit_surface_color = base_color_fractal * (diffuse_lighting * shadow_val + ambient_lighting) + specular_lighting * specular_highlight_color * shadow_val;
    float3 final_pixel_color = lerp(lit_surface_color, fresnel_rim_color, fresnel_effect * 0.6);

    return float4(saturate(final_pixel_color), 1.0);
}


// --- FUNCION PRINCIPAL DE RENDERIZADO (COMÚN) ---
float4 RenderFractal(float2 uv, int activeFractalType)
{
    if (activeFractalType == 1) // Menger Sponge (Lógica Original)
    {
        return RenderMengerSponge3D_OriginalLogic(uv,
                                                  CameraPos.xyz, CameraDirX.xyz, CameraDirY.xyz, CameraDirZ.xyz,
                                                  ZoomOffset.x, // menger_size
                                                  maxiter, // iterations
                                                  Options3D.z, // hit_thresh
                                                  Options3D.y, // max_dist
                                                  (int) Options3D.x, // max_steps
                                                  FractalColor.xyz, BackgroundColor.xyz);
    }
    else // Mandelbulb (Nueva Lógica con Path Tracing)
    {
        float time = TimeAndResolution.x;
        float3 ro = CameraPos.xyz;
        // Si Mandelbulb usa ZoomOffset.x como distancia de cámara:
        // ro += CameraDirZ.xyz * ZoomOffset.x; // Descomentar si es necesario para Mandelbulb

        float3 rd = normalize(uv.x * CameraDirX.xyz + uv.y * CameraDirY.xyz + CameraDirZ.xyz);

        int maxStepsPrimary = int(Options3D.x);
        float maxDistScene = Options3D.y;
        float hitThreshold = Options3D.z;
        float actualNormalEpsilon = hitThreshold * normalEpsilonScale;

        float mandelbulbAnimPower = lerp(FractalParams1.y, 11.0, sin(time * AnimationParams.x * 0.4) * 0.5 + 0.5);
        
        float3 sceneLightPos = LightPositionAndRadius.xyz;
        float sceneLightRadius = LightPositionAndRadius.w;
        float3 sceneLightEmissive = LightColorAndIntensity.rgb * LightColorAndIntensity.a;

        float3 accumulatedColor = float3(0, 0, 0);
        float pathThroughput = 1.0;
        float3 currentRayOrigin = ro;
        float3 currentRayDirection = rd;
        const int MAX_BOUNCES = 2;

        for (int bounce = 0; bounce <= MAX_BOUNCES; ++bounce)
        {
            RayHitResult_PathTraced hit = castRay_PathTraced(currentRayOrigin, currentRayDirection,
                                               mandelbulbAnimPower,
                                               sceneLightPos, sceneLightRadius,
                                               (bounce == 0) ? maxStepsPrimary : maxStepsPrimary / (bounce + 2),
                                               maxDistScene, hitThreshold, actualNormalEpsilon);

            if (!hit.isHit)
            {
                accumulatedColor += pathThroughput * GetBackgroundColorFromRay_PathTraced(currentRayDirection);
                break;
            }
            if (hit.objectType == 2)
            {
                accumulatedColor += pathThroughput * sceneLightEmissive * directLightBrightness;
                break;
            }

            float3 V = normalize(currentRayOrigin - hit.hitPos);
            float3 hitBaseColor = hit.baseColorIfFractal;
            float3 directIllumContribution;
            if (bounce == 0)
            {
                float3 pointLightDir = normalize(sceneLightPos - hit.hitPos);
                float diffuse = saturate(dot(hit.normal, pointLightDir));
                float specPower = 32.0;
                float3 halfwayDir = normalize(pointLightDir + V);
                float specAngle = saturate(dot(hit.normal, halfwayDir));
                float specular = pow(specAngle, specPower);
                float ao = calculateAO_PathTraced(hit.hitPos, hit.normal, mandelbulbAnimPower, hitThreshold, actualNormalEpsilon);
                float distToLightSq = dot(sceneLightPos - hit.hitPos, sceneLightPos - hit.hitPos);
                float attenuation = 1.0 / (1.0 + 0.05 * sqrt(distToLightSq) + 0.02 * distToLightSq);
                directIllumContribution = (hitBaseColor * diffuse * directLightBrightness + float3(1, 1, 1) * specular * directLightBrightness * 0.8) * ao * sceneLightEmissive * attenuation +
                                          hitBaseColor * ambientLightBrightness * ao;
            }
            else
            {
                directIllumContribution = getPointDirectIllumination_PathTraced(hit.hitPos, hit.normal, V, hitBaseColor, sceneLightPos, sceneLightEmissive);
            }

            if (bounce == MAX_BOUNCES)
            {
                accumulatedColor += pathThroughput * directIllumContribution;
                break;
            }
            
            float NdotV = saturate(dot(hit.normal, V));
            float fresnel = pow(1.0 - NdotV, fresnelStrength);
            float reflectivity = reflectivityFactor * fresnel;

            accumulatedColor += pathThroughput * directIllumContribution * (1.0 - reflectivity);
            pathThroughput *= reflectivity * hitBaseColor;
            
            if (dot(pathThroughput, pathThroughput) < 0.001)
                break;

            currentRayOrigin = hit.hitPos + hit.normal * hitThreshold * 1.5f; // Mover un poco fuera por la normal
            currentRayDirection = reflect(currentRayDirection, hit.normal);
        }
        return float4(saturate(accumulatedColor), 1.0);
    }
}


RWTexture2D<float4> OutputTex : register(u0);

[numthreads(32, 32, 1)]
void CSMain(uint3 DTid : SV_DispatchThreadID)
{
    uint width, height;
    OutputTex.GetDimensions(width, height);
    if (DTid.x >= width || DTid.y >= height)
        return;

    float2 uv = float2(DTid.xy) / float2(width, height) * 2.0 - 1.0;
    uv.x *= width / (float) height;

    int fractalTypeFromApp = int(TimeAndResolution.w);
    OutputTex[DTid.xy] = RenderFractal(uv, fractalTypeFromApp);
}