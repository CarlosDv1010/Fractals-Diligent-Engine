cbuffer Constants : register(b0)
{
    float4 TimeAndResolution; // x=time, y=res.x, z=res.y, w=fractType
    float4 CameraPos; // xyz=pos, w=is3D
    float4 CameraDirX; // xyz=right
    float4 CameraDirY; // xyz=up
    float4 CameraDirZ; // xyz=forward

    float4 ZoomOffset; // x=zoom/size, y=off.x, z=off.y, w=off.z
    float4 FractalColor; // rgba tint
    float4 BackgroundColor; // rgba background

    float4 FractalC; // x=c.x, y=c.y
    int maxiter; // Usado para Menger iterations
    float3 FractalParams1; // x=bailout(unused), y=power_mandelbulb_min, z=unused
    float4 FractalParams2; // x=gamma(unused), y/z/w extras

    float4 Options3D; // x=maxSteps, y=maxDist, z=threshold, w=unused
    float4 AnimationParams; // x=timeScale, y=unused, z=unused, w=unused

    float4 LightPositionAndRadius; // xyz=pos, w=radius
    float4 LightColorAndIntensity; // rgb=color, a=intensity

    float aoStrengthMultiplier;
    float directLightBrightness;
    float ambientLightBrightness;
    float reflectivityFactor;
    float fresnelStrength;
    float normalEpsilonScale;
    int BOUNCESMAX;
    float padding;
};

// --- FUNCIONES COMUNES DE PATH TRACING ---
float rand_PathTraced(float2 co)
{
    return frac(sin(dot(co.xy, float2(12.9898, 78.233))) * 43758.5453);
}

float SDF_Sphere_PathTraced(float3 p, float3 center, float radius)
{
    return length(p - center) - radius;
}

struct RayHitResult_PathTraced
{
    bool isHit;
    float3 hitPos;
    float3 normal;
    float distance;
    int objectType;
    float3 baseColorIfFractal;
};

float3 GetBackgroundColorFromRay_PathTraced(float3 rayDir)
{
    float gradientFactor = saturate(rayDir.y * 0.5 + 0.5);
    float3 horizonColor = float3(0.6, 0.7, 0.85);
    return lerp(horizonColor, BackgroundColor.xyz, gradientFactor);
}

// --- FUNCIONES PARA MANDELBULB ---
float DE_Mandelbulb_PathTraced(float3 pos, float power)
{
    float3 z = pos;
    float dr = 1.0;
    float r = 0.0;
    const float bailout = 2.0;
    const float bailout2 = bailout * bailout;
    const int iterDE = 60;

    for (int i = 0; i < iterDE; ++i)
    {
        float r2 = dot(z, z);
        r = sqrt(r2);
        if (r2 > bailout2)
            break;
        float theta = acos(clamp(z.z / r, -1.0, 1.0));
        float phi = atan2(z.y, z.x);
        dr = pow(r, power - 1.0) * power * dr + 1.0;
        float zr = pow(r, power);
        float ntheta = theta * power;
        float nphi = phi * power;
        float sinT = sin(ntheta);
        z = zr * float3(sinT * cos(nphi), sinT * sin(nphi), cos(ntheta)) + pos;
    }
    return 0.5 * log(r) * r / dr;
}

float3 calculateNormalMandelbulb_PathTraced(float3 p, float power, float epsilon)
{
    float3 n = float3(
        DE_Mandelbulb_PathTraced(p + float3(epsilon, 0, 0), power) - DE_Mandelbulb_PathTraced(p - float3(epsilon, 0, 0), power),
        DE_Mandelbulb_PathTraced(p + float3(0, epsilon, 0), power) - DE_Mandelbulb_PathTraced(p - float3(0, epsilon, 0), power),
        DE_Mandelbulb_PathTraced(p + float3(0, 0, epsilon), power) - DE_Mandelbulb_PathTraced(p - float3(0, 0, epsilon), power)
    );
    return normalize(n);
}

RayHitResult_PathTraced castRay_Mandelbulb_PT(float3 ro, float3 rd,
                                           float mandelbulbPower,
                                           float3 lightPos, float lightRadius,
                                           int maxSteps, float maxDist, float thresh, float normal_epsilon_world)
{
    RayHitResult_PathTraced result;
    result.isHit = false;
    result.distance = maxDist;
    result.objectType = 0;
    result.baseColorIfFractal = FractalColor.xyz;
    float totalDist = 0.0;
    const float MIN_STEP_FACTOR_MB = 0.05f; // Avance mínimo para Mandelbulb

    for (int i = 0; i < maxSteps; ++i)
    {
        float3 p_world = ro + rd * totalDist;
        float distToFractal_world = DE_Mandelbulb_PathTraced(p_world, mandelbulbPower);
        float distToLight_world = SDF_Sphere_PathTraced(p_world, lightPos, lightRadius);
        float distToScene_world = min(distToFractal_world, distToLight_world);
        
        float step_dist = max(distToScene_world, thresh * MIN_STEP_FACTOR_MB);
        totalDist += step_dist;

        if (distToScene_world < thresh)
        {
            result.isHit = true;
            result.hitPos = p_world - rd * (max(distToScene_world, 0.0f) - thresh * 0.5f);
            result.distance = totalDist - (max(distToScene_world, 0.0f) - thresh * 0.5f);
            if (distToLight_world < distToFractal_world)
            {
                result.objectType = 2;
                result.normal = normalize(result.hitPos - lightPos);
            }
            else
            {
                result.objectType = 1;
                result.normal = calculateNormalMandelbulb_PathTraced(result.hitPos, mandelbulbPower, normal_epsilon_world);
            }
            break;
        }
        if (totalDist > maxDist)
            break;
    }
    return result;
}

float calculateAO_Mandelbulb_PT(float3 pos_world, float3 normal_world, float mandelbulbPower, float thresh, float normal_epsilon_world)
{
    float occlusion = 0.0;
    const int aoSamples = 5;
    const float aoRadius = 0.5 * directLightBrightness;
    const float aoMaxDistStep = aoRadius / 2.5f;
    const float MIN_AO_STEP_FACTOR_MB = 0.05f;

    for (int i = 0; i < aoSamples; ++i)
    {
        float3 randomVec = float3(rand_PathTraced(pos_world.xy + float(i)) - 0.5, rand_PathTraced(pos_world.yz + float(i)) - 0.5, rand_PathTraced(pos_world.zx + float(i)) - 0.5);
        float3 sampleDir = normalize(normal_world + randomVec * 0.7f);
        if (dot(sampleDir, normal_world) < 0.05)
            sampleDir = reflect(sampleDir, normal_world);
        if (dot(sampleDir, normal_world) < 0.05)
            sampleDir = normal_world;

        float totalSampleDist = normal_epsilon_world * 1.5f;
        for (int j = 0; j < 5; ++j)
        {
            float3 pSample_world = pos_world + sampleDir * totalSampleDist;
            float dFractal_world = DE_Mandelbulb_PathTraced(pSample_world, mandelbulbPower);
            if (dFractal_world < thresh)
            {
                occlusion += (1.0 - smoothstep(0.0, aoRadius, totalSampleDist));
                break;
            }
            float step_dist_ao = max(dFractal_world, thresh * MIN_AO_STEP_FACTOR_MB);
            totalSampleDist += min(step_dist_ao, aoMaxDistStep);
            if (totalSampleDist > aoRadius)
                break;
        }
    }
    return saturate(1.0 - (occlusion / float(aoSamples)) * aoStrengthMultiplier);
}


// --- FUNCIONES PARA MENGER SPONGE ---
float DE_MengerSponge_Original(float3 pos, int iterations)
{
    float d = length(max(abs(pos) - 1.0, 0.0));
    float s = 1.0;
    for (int i = 0; i < iterations; ++i)
    {
        s /= 3.0;
        float3 a = fmod(abs(pos), 2.0 * s) - s;
        float da = max(abs(a.x), abs(a.y));
        float db = max(abs(a.y), abs(a.z));
        float dc = max(abs(a.z), abs(a.x));
        d = max(d, -min(da, min(db, dc)));
    }
    return d;
}

float getCross_Original(float3 p, float size_for_cross)
{
    p = abs(p) - size_for_cross / 3.0;
    float bx = max(p.y, p.z);
    float by = max(p.x, p.z);
    float bz = max(p.x, p.y);
    return min(min(bx, by), bz);
}

float getInnerMenger_Original(float3 p, float menger_size, int iterations, float initial_dist_thresh)
{
    float d = initial_dist_thresh;
    float scale = 1.0;
    for (int i = 0; i < iterations; i++)
    {
        float r = menger_size / scale;
        float3 q = fmod(p + r, 2.0 * r) - r; 
        d = min(d, getCross_Original(q, r));
        scale *= 3.0;
    }
    return d;
}


float4 map_Menger_Original(float3 p, float menger_size, int iterations, float initial_dist_thresh)
{
    float3 col = FractalColor.xyz;
    float d_inner = getInnerMenger_Original(p, menger_size, iterations, initial_dist_thresh);
    float d_sdf = -d_inner; 
    return float4(col, d_sdf);
}

float3 getNormal_Menger_Original(float3 p, float menger_size, int iterations, float thresh_for_epsilon, float initial_dist_thresh_for_map)
{
    float2 e = float2(thresh_for_epsilon * 0.5f, 0.0);
    float d_center = map_Menger_Original(p, menger_size, iterations, initial_dist_thresh_for_map).w;
    float3 n = d_center - float3(
        map_Menger_Original(p - e.xyy, menger_size, iterations, initial_dist_thresh_for_map).w,
        map_Menger_Original(p - e.yxy, menger_size, iterations, initial_dist_thresh_for_map).w,
        map_Menger_Original(p - e.yyx, menger_size, iterations, initial_dist_thresh_for_map).w
    );
    return normalize(n);
}


RayHitResult_PathTraced castRay_Menger_PT(float3 ro, float3 rd,
                                          float mengerSize, int mengerIterations,
                                          float3 lightPos, float lightRadius,
                                          int maxSteps, float maxDist, float thresh, float normal_epsilon_world)
{
    RayHitResult_PathTraced result;
    result.isHit = false;
    result.distance = maxDist;
    result.objectType = 0;
    result.baseColorIfFractal = FractalColor.xyz;
    float totalDist = 0.0;
    const float MIN_STEP_FACTOR = 0.1f; 
    float initial_dist_thresh_param = mengerSize;

    for (int i = 0; i < maxSteps; ++i)
    {
        float3 p_world = ro + rd * totalDist;
        
        float distToFractal_world = map_Menger_Original(p_world, mengerSize, mengerIterations, initial_dist_thresh_param).w;
        
        float distToLight_world = SDF_Sphere_PathTraced(p_world, lightPos, lightRadius);
        float distToScene_world = min(distToFractal_world, distToLight_world);
        
        float step_dist = max(distToScene_world, thresh * MIN_STEP_FACTOR);
        totalDist += step_dist;

        if (distToScene_world < thresh)
        {
            result.isHit = true;
            result.hitPos = p_world - rd * (max(distToScene_world, 0.0f) - thresh * 0.5f);
            result.distance = totalDist - (max(distToScene_world, 0.0f) - thresh * 0.5f);
            
            if (distToLight_world < distToFractal_world)
            {
                result.objectType = 2;
                result.normal = normalize(result.hitPos - lightPos);
            }
            else
            {
                result.objectType = 1;
                result.normal = getNormal_Menger_Original(result.hitPos, mengerSize, mengerIterations, normal_epsilon_world, initial_dist_thresh_param);
            }
            break;
        }
        if (totalDist > maxDist)
            break;
    }
    return result;
}

float calculateAO_Menger_PT(float3 pos_world, float3 normal_world,
                            float mengerSize, int mengerIterations,
                            float thresh,
                            float actual_normal_epsilon_param,
                            float ao_strength_mult, float direct_light_brightness_for_ao_radius)
{
    float occlusion = 0.0;
    const int aoSamples = 5;
    const float aoRadius = 0.4 * direct_light_brightness_for_ao_radius;
    const float aoMaxDistStep = aoRadius / 3.0f;
    const float MIN_AO_STEP_FACTOR = 0.1f;

    float initial_dist_thresh_param_ao = mengerSize;

    for (int i = 0; i < aoSamples; ++i)
    {
        float3 randomVec = float3(rand_PathTraced(pos_world.xy + float(i)) - 0.5, rand_PathTraced(pos_world.yz + float(i)) - 0.5, rand_PathTraced(pos_world.zx + float(i)) - 0.5);
        float3 sampleDir = normalize(normal_world + randomVec * 0.8f);
        if (dot(sampleDir, normal_world) < 0.1)
            sampleDir = normal_world;

        float totalSampleDist = actual_normal_epsilon_param * 2.0f; 
        for (int j = 0; j < 5; ++j)
        {
            float3 pSample_world = pos_world + sampleDir * totalSampleDist;
            float dFractal_world = map_Menger_Original(pSample_world, mengerSize, mengerIterations, initial_dist_thresh_param_ao).w;
            
            if (dFractal_world < thresh * 0.5f)
            {
                occlusion += (1.0 - smoothstep(0.0, aoRadius, totalSampleDist));
                break;
            }
            
            float step_dist_ao = max(dFractal_world, thresh * MIN_AO_STEP_FACTOR);
            totalSampleDist += min(step_dist_ao, aoMaxDistStep);
            if (totalSampleDist > aoRadius)
                break;
        }
    }
    return saturate(1.0 - (occlusion / float(aoSamples)) * ao_strength_mult);
}

// --- FUNCION PRINCIPAL DE RENDERIZADO ---
float4 RenderFractal(float2 uv, int activeFractalType)
{
    float time = TimeAndResolution.x;
    float3 ro = CameraPos.xyz;
    float3 rd = normalize(uv.x * CameraDirX.xyz + uv.y * CameraDirY.xyz + CameraDirZ.xyz);

    int maxStepsPrimary = int(Options3D.x);
    float maxDistScene = Options3D.y;
    float hitThreshold = Options3D.z;
    float actualNormalEpsilon = max(hitThreshold * normalEpsilonScale, 0.00001f);

    float3 sceneLightPos = LightPositionAndRadius.xyz;
    float sceneLightRadius = LightPositionAndRadius.w;
    float3 sceneLightEmissive = LightColorAndIntensity.rgb * LightColorAndIntensity.a;

    float3 accumulatedColor = float3(0, 0, 0);
    float pathThroughput = 1.0;
    float3 currentRayOrigin = ro;
    float3 currentRayDirection = rd;
    const int MAX_BOUNCES = BOUNCESMAX;

    float menger_size_param = ZoomOffset.x;
    int menger_iterations_param = maxiter;
    
    float mandelbulbAnimPower = lerp(FractalParams1.y, 11.0, sin(time * AnimationParams.x * 0.4) * 0.5 + 0.5);

    for (int bounce = 0; bounce <= MAX_BOUNCES; ++bounce)
    {
        RayHitResult_PathTraced hit;
        int currentMaxSteps = (bounce == 0) ? maxStepsPrimary : max(32, maxStepsPrimary / (bounce + 2));

        if (activeFractalType == 1) // Menger Sponge con Path Tracing
        {
            hit = castRay_Menger_PT(currentRayOrigin, currentRayDirection,
                                    menger_size_param, menger_iterations_param,
                                    sceneLightPos, sceneLightRadius,
                                    currentMaxSteps, maxDistScene, hitThreshold, actualNormalEpsilon);
        }
        else // Mandelbulb con Path Tracing
        {
            hit = castRay_Mandelbulb_PT(currentRayOrigin, currentRayDirection,
                                       mandelbulbAnimPower,
                                       sceneLightPos, sceneLightRadius,
                                       currentMaxSteps, maxDistScene, hitThreshold, actualNormalEpsilon);
        }

        if (!hit.isHit)
        {
            accumulatedColor += pathThroughput * GetBackgroundColorFromRay_PathTraced(currentRayDirection);
            break;
        }

        if (hit.objectType == 2)
        {
            accumulatedColor += pathThroughput * sceneLightEmissive * directLightBrightness;
            break;
        }

        float3 V = normalize(currentRayOrigin - hit.hitPos);
        float3 hitBaseColor = hit.baseColorIfFractal;
        float3 directIllumContribution = float3(0, 0, 0);
        float ao = 1.0;

        if (bounce == 0)
        {
            if (activeFractalType == 1)
            {
                ao = calculateAO_Menger_PT(hit.hitPos, hit.normal,
                                           menger_size_param, menger_iterations_param,
                                           hitThreshold, actualNormalEpsilon,
                                           aoStrengthMultiplier, directLightBrightness);
            }
            else
            {
                ao = calculateAO_Mandelbulb_PT(hit.hitPos, hit.normal, mandelbulbAnimPower, hitThreshold, actualNormalEpsilon);
            }

            float3 pointLightDir = normalize(sceneLightPos - hit.hitPos);
            float diffuse = saturate(dot(hit.normal, pointLightDir));
            
            float shadow = 1.0;
            RayHitResult_PathTraced shadowHit;
            float distToLightSource = length(sceneLightPos - hit.hitPos);
            
            float3 shadowRayOrigin = hit.hitPos + hit.normal * actualNormalEpsilon * 2.0f;

            if (distToLightSource > actualNormalEpsilon * 3.0f)
            {
                int shadowMaxSteps = max(16, currentMaxSteps / 10);
                if (activeFractalType == 1)
                {
                    shadowHit = castRay_Menger_PT(
                        shadowRayOrigin, pointLightDir,
                        menger_size_param, menger_iterations_param,
                        sceneLightPos, 0.001f,
                        shadowMaxSteps, distToLightSource - actualNormalEpsilon * 2.5f,
                        hitThreshold, actualNormalEpsilon
                    );
                }
                else
                {
                    shadowHit = castRay_Mandelbulb_PT(
                        shadowRayOrigin, pointLightDir,
                        mandelbulbAnimPower,
                        sceneLightPos, 0.001f,
                        shadowMaxSteps, distToLightSource - actualNormalEpsilon * 2.5f,
                        hitThreshold, actualNormalEpsilon
                    );
                }
                if (shadowHit.isHit && shadowHit.distance < distToLightSource && shadowHit.objectType == 1)
                {
                    shadow = 0.10;
                }
            }

            float specPower = 32.0;
            float3 halfwayDir = normalize(pointLightDir + V);
            float specAngle = saturate(dot(hit.normal, halfwayDir));
            float specular = pow(specAngle, specPower);
            
            float distToLightSq = dot(sceneLightPos - hit.hitPos, sceneLightPos - hit.hitPos);
            float attenuation = 1.0 / (1.0 + 0.05 * sqrt(distToLightSq) + 0.02 * distToLightSq);
            
            directIllumContribution = (hitBaseColor * diffuse * directLightBrightness * shadow +
                                       float3(1, 1, 1) * specular * directLightBrightness * 0.8 * shadow) * ao * sceneLightEmissive * attenuation +
                                      hitBaseColor * ambientLightBrightness * ao;
        }
        else
        {
            directIllumContribution = hitBaseColor * ambientLightBrightness * 0.5f;
        }


        if (bounce == MAX_BOUNCES)
        {
            accumulatedColor += pathThroughput * directIllumContribution;
            break;
        }
        
        float NdotV = saturate(dot(hit.normal, V));
        float fresnel = pow(1.0 - NdotV, fresnelStrength);
        float reflectivity = reflectivityFactor * fresnel;

        accumulatedColor += pathThroughput * directIllumContribution * (1.0 - reflectivity);
        pathThroughput *= reflectivity * hitBaseColor;
        
        if (dot(pathThroughput, pathThroughput) < 0.001) 
            break;

        currentRayOrigin = hit.hitPos + hit.normal * actualNormalEpsilon * 1.5f;
        currentRayDirection = reflect(currentRayDirection, hit.normal);
    }
    return float4(saturate(accumulatedColor), 1.0);
}


RWTexture2D<float4> OutputTex : register(u0);

[numthreads(32, 32, 1)]
void CSMain(uint3 DTid : SV_DispatchThreadID)
{
    uint width, height;
    OutputTex.GetDimensions(width, height);
    if (DTid.x >= width || DTid.y >= height)
        return;

    float2 uv = float2(DTid.xy) / float2(width, height) * 2.0 - 1.0;
    uv.x *= width / (float) height;

    int fractalTypeFromApp = int(TimeAndResolution.w);
    OutputTex[DTid.xy] = RenderFractal(uv, fractalTypeFromApp);
}